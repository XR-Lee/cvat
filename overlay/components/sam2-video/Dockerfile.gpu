# CUDA userland is private to this service. No host driver install/reload.
FROM cvat.pth.facebookresearch.sam2_1_hiera_large:latest
RUN pip3 install --no-cache-dir --upgrade --force-reinstall torch==2.9.0 torchvision==0.24.0 --index-url https://download.pytorch.org/whl/cu128
COPY driver-libs/ /opt/nvidia-595.71.05/
RUN cd /opt/nvidia-595.71.05 && for lib in libcuda libnvidia-ml libnvidia-ptxjitcompiler libnvidia-gpucomp; do ln -s ${lib}.so.595.71.05 ${lib}.so.1; done
ENV LD_LIBRARY_PATH=/opt/nvidia-595.71.05
ENV NVIDIA_VISIBLE_DEVICES=void
ENV SAM_DEVICE=cuda
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
