  "pth-facebookresearch-sam2-1-hiera-large": {
    "metadata": {
      "name": "pth-facebookresearch-sam2-1-hiera-large",
      "namespace": "nuclio",
      "labels": {
        "nuclio.io/project-name": "cvat"
      },
      "annotations": {
        "help_message": "Point/box segmentation, not text detection. Click Add visual prompts, left-click inside the object, and right-click to exclude background. Turn off Start with a bounding box for point-only input. CPU image encoding runs on the first prompt; later clicks reuse the embedding.",
        "min_neg_points": "0",
        "min_pos_points": "0",
        "name": "SAM 2.1 - Point & Box",
        "spec": "[]",
        "startswith_box_optional": "true",
        "type": "interactor",
        "version": "2"
      }
    },
    "spec": {
      "description": "Interactive segmentation with Meta SAM 2.1 Hiera Large",
      "handler": "main:handler",
      "runtime": "python:3.10",
      "env": [
        {
          "name": "PYTHONPATH",
          "value": "/opt/nuclio"
        },
        {
          "name": "HF_HOME",
          "value": "/opt/hf"
        },
        {
          "name": "HF_HUB_DISABLE_XET",
          "value": "1"
        },
        {
          "name": "MODEL_ID",
          "value": "facebook/sam2.1-hiera-large"
        }
      ],
      "resources": {
        "requests": {
          "cpu": "25m",
          "memory": "1Mi"
        }
      },
      "image": "cvat.pth.facebookresearch.sam2_1_hiera_large:latest",
      "targetCPU": 75,
      "triggers": {
        "myHttpTrigger": {
          "class": "",
          "kind": "http",
          "name": "myHttpTrigger",
          "numWorkers": 1,
          "workerAvailabilityTimeoutMilliseconds": 240000,
          "attributes": {
            "maxRequestBodySize": 67108864,
            "streamingFlushPeriod": "1s"
          },
          "mode": "sync"
        }
      },
      "build": {
        "functionConfigPath": "serverless/pytorch/facebookresearch/sam2/nuclio/function.yaml",
        "image": "cvat.pth.facebookresearch.sam2_1_hiera_large",
        "noBaseImagesPull": true,
        "baseImage": "ubuntu:22.04",
        "directives": {
          "preCopy": [
            {
              "kind": "ENV",
              "value": "DEBIAN_FRONTEND=noninteractive"
            },
            {
              "kind": "ENV",
              "value": "HF_HOME=/opt/hf"
            },
            {
              "kind": "ENV",
              "value": "HF_HUB_DISABLE_XET=1"
            },
            {
              "kind": "ENV",
              "value": "MODEL_ID=facebook/sam2.1-hiera-large"
            },
            {
              "kind": "RUN",
              "value": "apt-get update && apt-get install -y --no-install-recommends python-is-python3 python3-pip python3-dev gcc g++ libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*"
            },
            {
              "kind": "RUN",
              "value": "pip3 install --no-cache-dir torch==2.9.0 torchvision==0.24.0 --extra-index-url https://download.pytorch.org/whl/cpu"
            },
            {
              "kind": "RUN",
              "value": "pip3 install --no-cache-dir \"transformers>=4.57,<5\" pillow numpy opencv-python-headless huggingface_hub"
            },
            {
              "kind": "RUN",
              "value": "python3 -c \"from huggingface_hub import snapshot_download; snapshot_download('facebook/sam2.1-hiera-large', allow_patterns=['*.json','*.safetensors','*.txt','*.model','tokenizer*'])\""
            }
          ]
        },
        "codeEntryType": "image",
        "timestamp": 1792876749
      },
      "platform": {
        "attributes": {
          "mountMode": "volume",
          "network": "cvat_cvat",
          "restartPolicy": {
            "maximumRetryCount": 3,
            "name": "always"
          }
        }
      },
      "readinessTimeoutSeconds": 240,
      "securityContext": {},
      "disableDefaultHTTPTrigger": false,
      "eventTimeout": "180s",
      "streamChunkTimeout": "",
      "lastDeployTimestamp": "1792876740812000451"
